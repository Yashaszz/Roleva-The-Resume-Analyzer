          "text"
        ],
        "title": "Bullet",
        "type": "object"
      },
      "BulletSuggestion": {
        "additionalProperties": false,
        "description": "A concrete improvement for one weak bullet.\n\nGrounding rule: the suggestion may not introduce facts (numbers, employers,\ntechnologies) absent from `original`. Violations are regenerated once, then\ndropped.",
        "properties": {
          "bullet_id": {
            "title": "Bullet Id",
            "type": "string"
          },
          "original": {
            "title": "Original",
            "type": "string"
          },
          "suggestion": {
            "title": "Suggestion",
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "section": {
            "$ref": "#/components/schemas/SectionKind"
          }
        },
        "required": [
          "bullet_id",
          "original",
          "suggestion",
          "section"
        ],
        "title": "BulletSuggestion",
        "type": "object"
      },
