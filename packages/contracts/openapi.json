{
  "openapi": "3.1.0",
  "info": {
    "title": "Roleva API",
    "description": "Evidence-based resume analysis.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness probe.\n\nAlso the warm-up endpoint: the frontend pings this the moment a user lands\non the upload page, so Render's free-tier instance wakes up during the ~60s\nthe user spends picking a file and pasting a job description.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Me",
        "description": "Confirms a token is valid. Returns the user id only \u2014 the backend has no\nreason to echo an email address back to a client that already has it.",
        "operationId": "me_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Me Me Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AnalysisStatus": {
        "enum": [
          "pending",
          "running",
          "complete",
          "partial",
          "failed"
        ],
        "title": "AnalysisStatus",
        "type": "string"
      },
      "AtsFinding": {
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "$ref": "#/components/schemas/AtsRuleId"
          },
          "severity": {
            "$ref": "#/components/schemas/AtsSeverity"
          },
          "deduction": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Deduction",
            "type": "number"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "fix": {
            "title": "Fix",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page"
          },
          "occurrences": {
            "default": 1,
            "minimum": 1,
            "title": "Occurrences",
            "type": "integer"
          }
        },
        "required": [
          "rule_id",
          "severity",
          "deduction",
          "title",
          "detail",
          "fix"
