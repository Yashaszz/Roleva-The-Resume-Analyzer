      "DateRange": {
        "additionalProperties": false,
        "description": "Employment/education dates. Always parsed deterministically in Python \u2014\nnever taken from an LLM, which is unreliable at date arithmetic.",
        "properties": {
          "start_year": {
            "anyOf": [
              {
                "maximum": 2100,
                "minimum": 1950,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Year"
          },
          "start_month": {
            "anyOf": [
              {
                "maximum": 12,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Month"
          },
          "end_year": {
            "anyOf": [
              {
                "maximum": 2100,
                "minimum": 1950,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Year"
          },
          "end_month": {
            "anyOf": [
              {
                "maximum": 12,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Month"
          },
          "is_current": {
            "default": false,
            "title": "Is Current",
            "type": "boolean"
          },
          "raw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Raw"
          }
        },
        "title": "DateRange",
        "type": "object"
      },
