      "Evidence": {
        "additionalProperties": false,
        "description": "One piece of support for a requirement, anchored in the resume text.\n\nInvariant: `span.verify(resume_text)` must pass before this is shown to a\nuser. Unverifiable evidence is dropped, which makes hallucinated evidence\nstructurally impossible to display.",
        "properties": {
          "span": {
            "$ref": "#/components/schemas/Span"
          },
          "origin": {
            "$ref": "#/components/schemas/SkillOrigin"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "similarity": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Similarity"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Note"
          }
        },
        "required": [
          "span",
          "origin",
          "provenance"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "ExpectedBand": {
        "additionalProperties": false,
        "description": "Reference range for a role family + seniority. Curated, not measured \u2014\nalways labelled as a \"typical range\", never as a percentile.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ScoreKind"
