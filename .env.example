# ============================================================
# Roleva — environment template
# Copy to .env (backend) and apps/web/.env.local (frontend).
# NEVER commit the real .env files.
# ============================================================

# ---------- Supabase ----------
# Project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend only, NEVER in the browser
SUPABASE_JWT_SECRET=your-jwt-secret               # backend only, verifies tokens

# ---------- Gemini ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_LIGHT=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Free-tier guardrails — set these from your actual AI Studio limits
LLM_MAX_RPM=10
LLM_MAX_RPD=250
LLM_MAX_CALLS_PER_ANALYSIS=6

# ---------- App ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# ---------- Quotas ----------
USER_DAILY_ANALYSIS_QUOTA=5
IP_HOURLY_ANALYSIS_QUOTA=20

# ---------- Observability (optional in dev) ----------
SENTRY_DSN=

# ---------- Frontend (apps/web/.env.local) ----------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# API_BASE_URL=http://localhost:8000
