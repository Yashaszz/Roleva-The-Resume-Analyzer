# Dependencies
node_modules/
.pnpm-store/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Next.js
.next/
out/
.vercel/

# Environment — NEVER commit real keys
.env
.env.local
.env.*.local
!.env.example

# Editors
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test artifacts
coverage/
.coverage
htmlcov/
playwright-report/
test-results/

# Resume fixtures. Synthetic ones are regenerated by generate_resumes.py, so
# several MB of reproducible binaries stay out of git. Real resumes must never
# be committed at all — they are somebody's personal data.
apps/api/tests/fixtures/resumes/*.pdf
!apps/api/tests/fixtures/resumes/.gitkeep

# Generated
packages/contracts/generated/

# TypeScript incremental build cache
*.tsbuildinfo
